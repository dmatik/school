{
  "name": "mobile",
  "version": "1.7.3",
  "main": "index.ts",
  "dependencies": {
    "@expo-google-fonts/heebo": "^0.4.2",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@react-native-async-storage/async-storage": "2.2.0",
    "date-fns": "^4.4.0",
    "expo": "~58.0.26",
    "expo-blur": "~58.0.6",
    "expo-dev-client": "~58.0.21",
    "expo-file-system": "~58.0.14",
    "expo-font": "~58.0.12",
    "expo-image-picker": "~58.0.10",
    "expo-localization": "~58.0.5",
    "expo-print": "~58.0.9",
    "expo-secure-store": "~58.0.3",
    "expo-sharing": "~58.0.23",
    "expo-status-bar": "~58.0.5",
    "expo-updates": "~58.0.22",
    "i18next": "^27.2.1",
    "lucide-react-native": "^1.76.0",
    "react": "19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^18.0.3",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@storybook/react-native": "^10.7.2",
    "@types/react": "~19.3.0",
    "storybook": "^10.6.8",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "NODE_USE_SYSTEM_CA=1 expo start --dev-client",
    "start:go": "NODE_USE_SYSTEM_CA=1 expo start --go",
    "android": "NODE_USE_SYSTEM_CA=1 node scripts/start-dev.mjs --android",
    "ios": "NODE_USE_SYSTEM_CA=1 node scripts/start-dev.mjs --ios",
    "ios:release": "NODE_USE_SYSTEM_CA=1 expo run:ios --configuration Release --device",
    "ios:ipa": "NODE_USE_SYSTEM_CA=1 node scripts/build-ios-ipa.mjs",
    "web": "NODE_USE_SYSTEM_CA=1 expo start --web",
    "build:ios": "NODE_USE_SYSTEM_CA=1 expo run:ios",
    "build:android": "NODE_USE_SYSTEM_CA=1 expo run:android",
    "storybook": "EXPO_PUBLIC_STORYBOOK_ENABLED=true NODE_USE_SYSTEM_CA=1 expo start --dev-client --port 8082",
    "storybook:generate": "sb-rn-get-stories --config-path .rnstorybook",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint"
  },
  "overrides": {
    "glob": "^14.0.6",
    "minimatch": "^11.0.9"
  },
  "reanimated": {
    "staticFeatureFlags": {
      "IOS_SYNCHRONOUSLY_UPDATE_UI_PROPS": true
    }
  },
  "private": true
}
