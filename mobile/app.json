{
  "expo": {
    "name": "בית הספר",
    "slug": "school-mobile",
    "scheme": "school",
    "version": "1.7.6",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#f6f7fc",
      "dark": {
        "image": "./assets/splash-icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#090d16"
      }
    },
    "extra": {
      "supportsRTL": true,
      "eas": {
        "projectId": "7d5cf527-489c-4cbe-a8a9-4797c1884b03"
      }
    },
    "ios": {
      "bundleIdentifier": "com.dmatik.school",
      "supportsTablet": true,
      "splash": {
        "image": "./assets/splash-icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#f6f7fc",
        "dark": {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#090d16"
        }
      },
      "infoPlist": {
        "NSFaceIDUsageDescription": "אפליקציית בית הספר משתמשת ב-Face ID להתחברות מהירה ומאובטחת באמצעות מפתח גישה (Passkey).",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "android": {
      "package": "com.dmatik.school",
      "usesCleartextTraffic": true,
      "splash": {
        "image": "./assets/splash-icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#f6f7fc",
        "dark": {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#090d16"
        }
      },
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-localization",
      "expo-sharing",
      "expo-font"
    ],
    "owner": "dmatik",
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/7d5cf527-489c-4cbe-a8a9-4797c1884b03"
    }
  }
}
