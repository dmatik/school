{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "allowJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "paths": {
      "i18next": ["./app/node_modules/i18next"]
    }
  },
  "include": [
    "shared/**/*.ts",
    "e2e/**/*.ts",
    "playwright.config.ts"
  ]
}
