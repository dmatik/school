{
  "name": "school",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run app:web",
    "server": "node server/index.js",
    "dev:all": "concurrently \"npm run server\" \"npm run app:web\"",
    "build": "npm --prefix app run build:web",
    "lint": "eslint . && npm --prefix app run lint",
    "typecheck": "tsc --noEmit && npm run app:typecheck",
    "test": "npm run test:server && npm run test:web",
    "test:server": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.server.config.mjs",
    "test:web": "npm --prefix app test",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "screenshots": "node scripts/generate-screenshots.mjs",
    "app:start": "npm --prefix app run start",
    "app:go": "npm --prefix app run start:go",
    "app:ios": "npm --prefix app run ios",
    "app:ios:build": "npm --prefix app run build:ios",
    "app:ios:release": "npm --prefix app run ios:release",
    "app:ios:maestro": "npm --prefix app run ios:maestro",
    "app:android:maestro": "npm --prefix app run android:maestro",
    "app:ios:ipa": "npm --prefix app run ios:ipa",
    "app:android": "npm --prefix app run android",
    "app:storybook": "npm --prefix app run storybook",
    "app:web": "npm --prefix app run web:dev",
    "app:web:build": "npm --prefix app run build:web",
    "app:typecheck": "npm --prefix app run typecheck",
    "test:maestro": "node app/scripts/run-maestro-e2e.mjs",
    "test:maestro:android": "node app/scripts/run-maestro-e2e.mjs --android"
  },
  "dependencies": {
    "@simplewebauthn/server": "^14.0.3",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.2",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.64.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.10.1",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0"
  },
  "overrides": {
    "glob": "^14.0.6",
    "minimatch": "^11.0.9",
    "postcss-selector-parser": "^7.1.7"
  }
}
